---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { profile, projects, repositories, experience } from '../data/portfolio';
import { getContributions, summarize } from '../data/contributions';
const description = 'Lluc Matas — Software Engineer based in Mallorca. Professional experience, personal projects, and full-stack starters.';
const contributions = await getContributions(profile.github.split('/').pop()!);
const stats = contributions ? summarize(contributions) : null;
const fullDate = (date: string) => new Date(`${date}T00:00:00Z`).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const title = `Lluc Matas — ${profile.role} in Mallorca`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1626" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <!-- THESIS: A personal studio: meet Lluc, then explore his work. OWN-WORLD: Graphite #151718, off-white Manrope, slate-blue segmented navigation, flat unboxed captions. STORY: Read a short introduction, browse real personal projects, visit their sites or connect. FIRST VIEWPORT: A 1070px column; compact navigation above a modest name and right-aligned initials, bio and profile links, then a horizontal project filmstrip with real screenshots. FORM: User-approved K, Personal studio, overrides original seed 3ddb35e7. Signature interaction: a touch- and keyboard-browsable project strip with restrained image movement. FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance -->
    <a class="skip-link" href="#me">Skip to content</a>
    <div class="page-shell">
      <header class="site-header">
        <nav class="section-nav" aria-label="Main navigation">
          <a href="#me" aria-current="location">Me</a>
          <a href="#work">Work</a>
          <a href="#contact">Contact</a>
        </nav>
      </header>
      <main>
        <section class="introduction" id="me" aria-labelledby="name" tabindex="-1">
          <div class="identity">
            <div>
              <h1 id="name">{profile.name}</h1>
              <p class="role">{profile.role}<span class="role-separator" aria-hidden="true">·</span>{profile.location}</p>
            </div>
            <img class="avatar" src="/images/lluc-matas-avatar.jpg" alt={`Portrait of ${profile.name} in a car`} width="480" height="480" />
          </div>
          <div class="bio">
            <p>{profile.introduction}</p>
            <p>{profile.personal}</p>
          </div>
          <div class="profile-links">
            <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub<Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a>
            <a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </section>
        {contributions && stats && (
          <section class="contributions" id="activity" aria-labelledby="contributions-title">
            <div class="section-heading">
              <h2 id="contributions-title"><span class="contribution-total">{contributions.total.toLocaleString('en-US')}</span> contributions in the last year</h2>
              <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">On GitHub<Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a>
            </div>
            <div class="contribution-card" data-contribution-card>
              <div class="contribution-scroll" tabindex="0" role="region" aria-label="GitHub contribution graph, scrollable">
                <div class="contribution-body">
                  <div class="contribution-months" style={`--weeks: ${contributions.weeks.length}`} aria-hidden="true">
                    {stats.months.map((month) => <span style={`grid-column: ${month.column + 1}`}>{month.label}</span>)}
                  </div>
                  <div class="contribution-days" aria-hidden="true"><span>Mon</span><span>Wed</span><span>Fri</span></div>
                  <div class="contribution-graph" style={`--weeks: ${contributions.weeks.length}`} role="img" aria-label={`GitHub contribution graph: ${contributions.total} contributions on ${stats.activeDays} active days over the last year.`}>
                    {contributions.weeks.map((week, column) => week.map((day) => (
                      <span
                        class={`cell level-${day.level}`}
                        style={`grid-column: ${column + 1}; grid-row: ${new Date(`${day.date}T00:00:00Z`).getUTCDay() + 1}; --delay: ${column * 9}ms`}
                        data-count={day.count}
                        data-date={fullDate(day.date)}
                      ></span>
                    )))}
                  </div>
                </div>
              </div>
              <div class="contribution-tooltip" role="presentation" hidden></div>
              <div class="contribution-footer">
                <dl class="contribution-stats">
                  <div><dt>Current streak</dt><dd>{stats.current} {stats.current === 1 ? 'day' : 'days'}</dd></div>
                  <div><dt>Longest streak</dt><dd>{stats.longest} {stats.longest === 1 ? 'day' : 'days'}</dd></div>
                  <div><dt>Active days</dt><dd>{stats.activeDays}</dd></div>
                  <div><dt>Busiest day</dt><dd>{stats.busiest.count}</dd></div>
                </dl>
                <div class="contribution-legend" aria-hidden="true">
                  <span>Less</span>
                  <span class="cell level-0"></span><span class="cell level-1"></span><span class="cell level-2"></span><span class="cell level-3"></span><span class="cell level-4"></span>
                  <span>More</span>
                </div>
              </div>
            </div>
          </section>
        )}
        <section class="work" id="work" aria-labelledby="work-title" tabindex="-1">
          <div class="section-heading">
            <h2 id="work-title">A few things I've made</h2>
            <span class="section-note">Personal projects · Closed source</span>
          </div>
          <div class="project-browser" data-project-browser>
            <div class="project-controls" hidden>
              <button class="browse-button previous" type="button" aria-label="Previous project" aria-controls="project-strip" disabled><Icon name="left" /></button>
              <button class="browse-button next" type="button" aria-label="Next project" aria-controls="project-strip"><Icon name="right" /></button>
            </div>
            <ul class="project-strip" id="project-strip" aria-label="Personal projects. Scroll horizontally to explore.">
              {projects.map((project) => (
                <li class="project">
                  <a class="project-link" href={project.url} target="_blank" rel="noopener noreferrer">
                    <div class="project-preview">
                      <img src={project.image} alt={project.alt} width="1440" height="900" loading="eager" decoding="async" />
                      <span class="visit-label" aria-hidden="true">Visit website<Icon name="external" /></span>
                    </div>
                    <div class="project-title"><h3>{project.name}</h3><Icon name="external" /></div>
                    <p>{project.description}</p>
                    <span class="sr-only">Personal project, closed source. Opens in a new tab.</span>
                  </a>
                </li>
              ))}
            </ul>
            <p class="sr-only" role="status" data-project-status></p>
          </div>
          <details class="public-code">
            <summary><span>Public code <span class="repository-count">{repositories.length}</span></span><Icon name="plus" /></summary>
            <ul class="repository-list">
              {repositories.map((repo) => (
                <li><a href={repo.url} target="_blank" rel="noopener noreferrer"><span><span class="repository-name">{repo.name}</span><span class="repository-description">{repo.description}</span></span><Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a></li>
              ))}
            </ul>
          </details>
        </section>
        <section class="experience" id="experience" aria-labelledby="experience-title">
          <div class="experience-heading">
            <h2 id="experience-title">Experience</h2>
            <a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">View LinkedIn<Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a>
          </div>
          <ul class="experience-list">
            {experience.map((job) => (
              <li class="experience-entry">
                <div class="experience-title"><h3>{job.company}</h3>{job.period && <span class="experience-period">{job.period}</span>}</div>
                {job.role && <p class="experience-role">{job.role}</p>}
                <p class="experience-location">{job.location}</p>
                {job.description && <p class="experience-description">{job.description}</p>}
              </li>
            ))}
          </ul>
        </section>
      </main>
      <footer id="contact" tabindex="-1" aria-label="Contact and profiles">
        <span class="footer-label">Elsewhere</span>
        <div class="footer-links">
          <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub<Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a>
          <a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn<Icon name="external" /><span class="sr-only"> (opens in a new tab)</span></a>
        </div>
        <span class="footer-location">Made in Mallorca.</span>
      </footer>
    </div>
    <nav class="elevator" aria-label="Page sections" data-elevator>
      <button class="elevator-step" type="button" data-elevator-step="-1" aria-label="Previous section"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 15 6-6 6 6"/></svg></button>
      <ol class="elevator-shaft">
        <li class="elevator-cable" aria-hidden="true"><span class="elevator-fill"></span><span class="elevator-car"></span></li>
        <li><a href="#me" data-label="Me"><span class="sr-only">Me</span></a></li>
        <li><a href="#activity" data-label="Activity"><span class="sr-only">Activity</span></a></li>
        <li><a href="#work" data-label="Work"><span class="sr-only">Work</span></a></li>
        <li><a href="#experience" data-label="Experience"><span class="sr-only">Experience</span></a></li>
        <li><a href="#contact" data-label="Contact"><span class="sr-only">Contact</span></a></li>
      </ol>
      <button class="elevator-step" type="button" data-elevator-step="1" aria-label="Next section"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button>
    </nav>
    <script src="../scripts/portfolio.ts"></script>
  </body>
</html>
