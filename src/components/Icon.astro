---
interface Props {
  name: 'external' | 'left' | 'right' | 'plus';
  class?: string;
}
const { name, class: className } = Astro.props;
const paths = {
  external: 'M6 18 18 6M6 6h12v12',
  left: 'm14 6-6 6 6 6',
  right: 'm10 6 6 6-6 6',
  plus: 'M12 5v14M5 12h14',
};
---
<svg class={className} width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[name]} /></svg>
